{
  "name": "ADAPT-<site>-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "e2e:basic": "playwright test specs/basic",
    "e2e:orders": "playwright test specs/orders",
    "baseline": "playwright test --grep @visual --update-snapshots",
    "report": "playwright show-report reports",
    "setup:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "woolverine-lint specs && npm run typecheck"
  },
  "dependencies": {
    "@saucal/woolverine": "^2.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
