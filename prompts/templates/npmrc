# @saucal/woolverine and its @saucal/lokinator dependency live in GitHub Packages, private like
# their repos. NODE_AUTH_TOKEN needs read:packages — locally
# `export NODE_AUTH_TOKEN=$(gh auth token)` once the gh login carries the scope; in CI the
# workflow passes secrets.PACKAGES_TOKEN. Never write a token into this file.
@saucal:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
