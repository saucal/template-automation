# e2e/.env — next to e2e/package.json (cp .env.example .env). Never committed.
# One base URL per Playwright project (woolverine defineProjects): BASE_URL_<ENV> or BASE_URL_<REGION>_<ENV>.
# The e2e maintenance action exports BASE_URL and BASE_URL_<ENV> itself — locally you set them.
BASE_URL_STAGING=

# WordPress admin — lazy per-project auth (woolverine ensureAdminState), cached to auth/admin-<project>.json.
# Locally: the staging users ServiceApp's staging action creates. In the e2e maintenance action the
# runner generates e2e-bot / e2e-customer with per-run passwords and exports these names itself.
WP_ADMIN_USER=
ADMIN_PASS=

# The shopper account the suite logs in as. Assume it is BLANK (no orders, no addresses): the runner
# recreates it every run, so the suite creates whatever state it needs.
CUSTOMER_USER=
CUSTOMER_PASS=

# Staging behind basic auth: woolverine >= 2.1.0 turns these into every project's httpCredentials.
HTTP_AUTH_USER=
HTTP_AUTH_PASS=

# Mailpit trap that captures the staging outbound mail (default: the Playgrounds instance).
MAILPIT_URL=

# Sandbox gateway buyers, only the ones the suite pays with. A PayPal buyer MUST be a
# @playgrounds.saucal.io address (PPCP stamps the payer email onto the order).
PAY_PAL_USER=
PAY_PAL_PASS=
AFTERPAY_USER=
AFTERPAY_PASS=
# PAYPAL_DEBUG= / KLARNA_DEBUG=   1 = dump every tick, 2 = observe-only (never clicks the final confirm)

# Optional — lokinator's AI locator repair (last-resort tier). Without a key: primary → alt → cached fix.
# Repaired selectors land in .lokinator-cache.json — commit it; its diff is the selector-drift report.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=   accepted by lokinator; the org secret today is OPENAI_API_KEY only.
# Bare model id, no provider prefix (default gpt-5.4-mini).
LOKINATOR_MODEL=
